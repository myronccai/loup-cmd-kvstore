@mode(host.native)

# Rebuilding the kvstore index by replaying the log. A pure function of the
# file's text, so tests can replay hand-made logs without a file.
#
# Runtime: host.native. Compiled into the native binary build/kvstore by
# `make build` (Stage0 native build); tests/replay_test.lphc replays
# hand-made logs in native test binaries.
#
# File layout: the header line `KVSTORE 1`, then one record line per put or
# delete (store/codec.lphc). Replay stops at the first line that does not
# decode or is not terminated; everything from there to the end of the file
# is the torn tail, which the next writer cuts off (store/store.lphc).
#
# Structure: the Replay state, RecordReader (an iterator over the good
# records that counts their bytes), replay() (header check, then one
# `for` over a RecordReader), and queries on a Replay.

from store.codec import (Record, PUT, decode_line);

pub const HEADER: string = "KVSTORE 1\n";

pub struct Replay {
    # key -> latest value, for live keys only
    pub var index: dict[string, string];
    pub var puts: int;
    pub var deletes: int;
    # whether the file starts with a complete header
    pub var has_header: bool;
    # bytes of the header and the good records: where the next record goes
    pub var good_bytes: int;
    # bytes after good_bytes: an unterminated, malformed or corrupt tail
    pub var torn_bytes: int;
}

pub func empty_replay(): Replay {
    let index: dict[string, string] = {};
    return Replay(index = index, puts = 0, deletes = 0, has_header = false, good_bytes = 0, torn_bytes = 0);
}

# The good records of a log body (the text after the header), in order.
# Iteration stops at the first line that is not terminated or does not
# decode; good_bytes then counts the bytes up to there, which is where the
# next record must be written.
#
# It is its own Iterable (iter() returns itself), so replay() can read
# good_bytes after the `for` loop has used it up. A `for` over a custom
# Iterator works in the Stage0 native lane kvstore builds with; the
# self-hosted native build would run the loop zero times.
pub class RecordReader implements Iterable[Record], Iterator[Record] {
    # Every element but the last ended with a newline; the last is "" when
    # the file ends cleanly, or an unterminated (torn) record.
    let lines: list[string];
    var at: int = 0;
    pub var good_bytes: int;

    # `body` follows `start` bytes of the file that are already known good.
    new(body: string, start: int) {
        this.lines = body.split("\n");
        this.good_bytes = start;
    }

    pub func iter(): Iterator[Record] {
        return this;
    }

    pub modifier func next(): Option[Record] {
        if (this.at >= this.lines.len() - 1) {
            return None;
        }
        let line = this.lines[this.at];
        let decoded = decode_line(line);
        if (decoded.is_none()) {
            # The torn tail starts here: end the iteration for good.
            this.at = this.lines.len();
            return None;
        }
        # Records are ASCII: characters and bytes agree.
        this.good_bytes = this.good_bytes + line.len() + 1;
        this.at = this.at + 1;
        return decoded;
    }
}

# Replays `text`, the whole file, whose size in bytes is `size`. Err if the
# file is not a kvstore log (it does not start with the header, and is not a
# torn prefix of it either).
pub func replay(text: string, size: int): Result[Replay, string] {
    var state = empty_replay();
    if (!text.startsWith(HEADER)) {
        if (HEADER.startsWith(text)) {
            # Empty, or a crash while the header was being written.
            state.torn_bytes = size;
            return Ok(state);
        }
        return Err("not a kvstore log");
    }
    state.has_header = true;
    var reader = RecordReader(text.slice(HEADER.len()), HEADER.len());
    for (rec in reader) {
        if (rec.op == PUT) {
            state.index[rec.key] = rec.value;
            state.puts += 1;
        } else {
            state.index.remove(rec.key);
            state.deletes += 1;
        }
    }
    state.good_bytes = reader.good_bytes;
    state.torn_bytes = size - reader.good_bytes;
    return Ok(state);
}

pub func records(state: Replay): int {
    return state.puts + state.deletes;
}

# Records that no longer contribute to the state: overwritten puts, deletes,
# and the puts they deleted.
pub func stale_records(state: Replay): int {
    return records(state) - state.index.len();
}

# The live keys in ascending order.
pub func sorted_keys(state: Replay): list[string] {
    var keys: list[string] = [];
    for (k in state.index.keys()) {
        keys.push(k);
    }
    keys.sort(func(a: string, b: string): int {
        return if (a < b) { -1 } else if (a > b) { 1 } else { 0 };
    });
    return keys;
}
