@mode(host.native)

# Shared helpers for the kvstore tests. Not a test file itself: the tests
# import it.
#
# Runtime: host.native, test support. Never built on its own: `make test`
# puts tests/ on LOUPPATH, so `loup-bootstrap test --native` compiles it into
# each test binary that imports it. Not part of build/kvstore.

from debug.assert import (expect);
from store.logfile import (LogFile);

# expectEq on two strings fails in native tests even when they are equal
# (Loup 1.26.0), so string results are compared with ==.
pub func expect_text(actual: string, expected: string, context: string): void {
    expect(actual == expected, i"{$ context $}: expected '{$ expected $}', got '{$ actual $}'");
}

# An empty file at `path`, relative to the test binary's working directory
# (a fresh temporary directory for each test file).
pub func empty_file(path: string): string {
    let f = LogFile(path, true);
    del f;
    return path;
}
